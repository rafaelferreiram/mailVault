# ─── Secrets & credentials (never commit) ───────────────────────────────────
.env
.env.*
!.env.example

# OAuth / API keys often copied under alternate names
*.pem
*.p12
*.pfx
*.key
*.cer
credentials.json
credentials.*.json
secrets.json
secrets.*.json
client_secret*.json
service-account*.json
google-credentials.json
auth.json

# Local keychain fallback (normally in Application Support, not the repo)
keychain.dat
**/keychain.dat

# ─── Dependencies ───────────────────────────────────────────────────────────
node_modules/

# ─── Build & packaging outputs ────────────────────────────────────────────────
dist/
dist-electron/
release/
out/
build/
*.tsbuildinfo

# Vite / tooling caches
.vite/
.cache/
.parcel-cache/
.turbo/
.eslintcache

# Deploy / CI logs (may echo env paths or errors with account hints)
.deploy-log
.deploy-log.*

# ─── Runtime data (mail sync DBs, prefs — live under Application Support) ─────
# Ignore if copied into the repo for debugging
data/
*.db
*.sqlite
*.sqlite3
*.sqlite-shm
*.sqlite-wal

# Electron-store / config dumps
config.json
mailvault.json
preferences.json

# ─── Logs ─────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ─── Test & coverage ──────────────────────────────────────────────────────────
coverage/
.nyc_output/

# ─── OS & editor ──────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
Desktop.ini

# IDE / agent local state (can contain paths, tokens in debug configs)
.idea/
.vscode/
!.vscode/extensions.json
.cursor/
*.swp
*.swo
*~

# ─── macOS packaging artifacts (regenerated by deploy) ────────────────────────
# Keep source SVGs in assets/brand/; ignore generated binaries if present
assets/icon.icns
assets/brand/app-icon-1024.png
